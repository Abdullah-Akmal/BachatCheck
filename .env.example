# Copy to .env and fill in. Never commit .env.

# --- Backend / ingestion ---
# Local Docker Postgres (docker compose overrides this for the backend container).
DATABASE_URL=postgresql+psycopg://bachatcheck:bachatcheck@localhost:5432/bachatcheck
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false

# SBP EasyData API key — register at https://easydata.sbp.org.pk/ and copy the key from your profile.
SBP_EASYDATA_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
