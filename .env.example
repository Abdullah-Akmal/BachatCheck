# Copy to .env and fill in. Never commit .env.

# --- Backend / ingestion ---
# Local Docker Postgres (docker compose overrides this for the containers).
DATABASE_URL=postgresql+psycopg://bachatcheck:bachatcheck@localhost:5432/bachatcheck
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false

# real = show ingested data; demo = show demo data. Production: FUNDS_DATA_MODE=demo
# (MUFAP's terms forbid public display without written approval).
FUNDS_DATA_MODE=real
STOCKS_DATA_MODE=real

# SBP EasyData API key: register at https://easydata.sbp.org.pk/, then
# My Data Basket -> My Account -> Generate API Key. Keys EXPIRE AFTER 90 DAYS.
# Limits: 2,000 requests/day, 250/hour.
SBP_EASYDATA_API_KEY=

# PSX symbols fetched daily via psxdata (KSE100/KMI30 are stored as indices).
PSX_SYMBOLS=KSE100,KMI30,OGDC,PPL,HBL,MCB,UBL,MEBL,LUCK,HUBC,FFC,SYS

# --- API ---
# Macro series used as the default bank-savings rate (users can pass their own rate too).
SAVINGS_BENCHMARK_SERIES=DEPOSIT_RATE_FRESH
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=300
# Set true only behind a trusted reverse proxy (uses the first X-Forwarded-For hop).
TRUST_FORWARDED_FOR=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
